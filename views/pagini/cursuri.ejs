<!DOCTYPE html>
<html lang="ro">
<head>
    <%- include('../fragmente/head') %>
    <title>Cursuri - Școala pentru toți</title>
</head>
<body>
    <%- include('../fragmente/header') %>
    <main>
        <div id="grid-pagina">
            <section>
                <h2>Oferta noastră de cursuri</h2>
                <p>Alege pachetul care ți se potrivește. Folosim un sistem de <dfn title="Metodă de predare bazată pe practică">învățare activă</dfn> pentru rezultate garantate.</p>

                <section id="gestiune-cursuri">

                    <div class="container-cursuri-db" style="display: grid; gap: 20px;">
                        <% if (locals.cursuri && cursuri.length > 0) { %>
                            <% cursuri.forEach(function(curs) { %>
                                <div class="card-curs" style="border-left: 5px solid #2c3e50; padding: 15px; box-shadow: 2px 2px 5px rgba(0,0,0,0.1);">
                                    <h4 style="margin-top: 0;"><%= curs.TITLU %></h4>
                                    <p><%= curs.DESCRIERE %></p>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p style="color: #999;">Nu există cursuri în baza de date.</p>
                        <% } %>
                    </div>
                </section>
                </section>
        </div>
    </main>
    <%- include('../fragmente/footer') %>
</body>
</html>