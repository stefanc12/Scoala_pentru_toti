<header>
    <a href="/" title="Întoarce-te la pagina principală" class="logo-link" style="text-decoration: none; color: inherit; display: flex; align-items: center;">
        <img src="\Resurse\imagini\ico\web-app-manifest-512x512.png" alt="Sigla platformei" id="logo-site" />
        <h1>Școala pentru toți</h1> 
    </a>

    <div class="user-menu" style="margin-left: auto; display: flex; align-items: center;">
        <% if (locals.utilizator) { %>
            <span style="margin-right: 25px; font-weight: bold; color: #2c3e50;">
                Salut, <%= utilizator.PRENUME %>! 
            </span>
        <% } else { %>
            <a href="/cont" style="padding: 8px 15px; background: #3498db; color: white; text-decoration: none; border-radius: 5px; font-weight: bold;">Log in / Sign in</a>
        <% } %>
    </div>

    <div id="hamburger-menu">
        <span></span>
        <span></span>
        <span></span>
    </div>

    <nav>
    <ul>
        <li><a href="/" class="<%= locals.caleCurenta === '/' || locals.caleCurenta === '/index' ? 'activ' : '' %>">Acasă</a></li>
        <li><a href="/cursuri" class="<%= locals.caleCurenta === '/cursuri' ? 'activ' : '' %>">Cursuri</a></li>
        <li><a href="/exercitii" class="<%= locals.caleCurenta === '/exercitii' ? 'activ' : '' %>">Exerciții</a></li>
        <li><a href="/teste" class="<%= locals.caleCurenta === '/teste' ? 'activ' : '' %>">Teste</a></li>

        <% if (locals.utilizator) { %>
                <li>
                    <a href="/cont" class="<%= locals.caleCurenta === '/cont' ? 'activ' : '' %>">Contul meu</a>
                </li>
            <% } %>
    </ul>
</nav>
</header>

<style>
    
    .logo-link {
        display: flex;
        align-items: center;
        text-decoration: none;
        color: inherit;
        width : fit-content;
        padding: 5px 0;
        gap : 5px;
    }

    #logo-site {
        height: 65px; 
        width: auto;
        flex-shrink: 0;
        object-fit: contain;
        margin-right: 0px;
        transition: transform 0.3s ease;
    }

    #logo-site:hover {
        transform: scale(1.05); 
    }

    #titlu-site {
        font-size: 1.8rem; 
        margin: 0;
        line-height: 1.2;
        white-space: nowrap; 
    }

    
    @media screen and (max-width: 600px) {
        #logo-site {
            height: 50px;
        }
        #titlu-site {
            font-size: 1.3rem;
        }
    }
</style>